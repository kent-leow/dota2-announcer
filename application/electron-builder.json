{
  "appId": "com.dota2announcer.app",
  "productName": "Dota 2 Announcer",
  "directories": {
    "output": "dist/installer"
  },
  "files": [
    "dist/**/*",
    "!dist/installer",
    "assets/**/*",
    "config/**/*"
  ],
  "win": {
    "target": "nsis",
    "icon": "assets/dota2-announcer.png"
  },
  "mac": {
    "icon": "assets/dota2-announcer.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
