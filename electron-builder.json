{
  "appId": "com.dota2announcer.app",
  "productName": "Dota 2 Announcer",
  "directories": {
    "output": "dist/installer"
  },
  "files": [
    "dist/**/*",
    "!dist/installer"
  ],
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
